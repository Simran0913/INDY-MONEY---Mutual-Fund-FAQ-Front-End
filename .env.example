# ── Facts-Only Mutual Fund FAQ Assistant — Environment Variables ──────────────
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file to version control.

# ── Required: OpenAI API Key ───────────────────────────────────────────────────
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ── LLM Settings ──────────────────────────────────────────────────────────────
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=512

# ── Embedding Model (local, no API key needed) ─────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Retrieval Settings ────────────────────────────────────────────────────────
TOP_K=5
MIN_SCORE=0.25

# ── Chunking Settings ─────────────────────────────────────────────────────────
CHUNK_SIZE=600
CHUNK_OVERLAP=100

# ── API Server ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
# Set this in app/.env.local for local development, or as a GitHub Actions
# repository variable for GitHub Pages. Do not put secrets in this variable.
# NEXT_PUBLIC_API_URL=http://localhost:8000
